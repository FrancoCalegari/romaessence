<% locals.currentPath = 'historias'; %>
<%- include('./partials/layout-start') %>

<div class="page-header">
  <div>
    <h1>🤖 Historias IA</h1>
    <p>Generá imágenes publicitarias para redes sociales con IA</p>
  </div>
</div>

<!-- OpenRouter Credits Panel -->
<% if (locals.openRouterCredits) { %>
<div class="card" style="margin-bottom:1.5rem; background: linear-gradient(145deg, var(--card-bg) 0%, rgba(139, 92, 246, 0.05) 100%); border-left: 4px solid var(--accent);">
  <div class="card-body" style="padding: 1rem 1.25rem;">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
      <div style="display:flex; align-items:center; gap:0.75rem;">
        <div style="background: rgba(139, 92, 246, 0.1); color: var(--accent); padding: 0.5rem; border-radius: 8px;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </div>
        <div>
          <h3 style="margin:0; font-size:1rem; font-weight:600;">Estado de API OpenRouter</h3>
          <p style="margin:0; font-size:0.85rem; color:var(--text-muted);">
            Consumo total actual: <strong>$<%= openRouterCredits.usage.toFixed(4) %></strong>
            <% if (openRouterCredits.total > 0) { %>
              / Créditos: $<%= openRouterCredits.total.toFixed(4) %>
            <% } %>
          </p>
        </div>
      </div>
      <div>
        <div class="badge badge-purple" style="font-size:0.8rem; padding:0.4rem 0.8rem; font-weight: 500;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:4px; vertical-align:middle; display:inline-block;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
          Costo estimado por imagen: ~$0.101
        </div>
      </div>
    </div>
    <p style="margin: 0.5rem 0 0 0; font-size: 0.75rem; color: var(--text-muted); padding-left: 2.75rem;">
      * El consumo exacto de tokens varía dependiendo del prompt, cantidad de productos y el formato configurado.
    </p>
  </div>
</div>
<% } %>

<!-- Configuration Panel -->
<div class="card" style="margin-bottom:1.5rem;">
  <div class="card-header">
    <span class="card-title">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
      Configuración de generación
    </span>
  </div>
  <div class="card-body">
    <!-- Format Selector -->
    <div class="ai-section">
      <label class="ai-label">Formato de imagen</label>
      <div class="ai-format-grid">
        <button type="button" class="ai-format-btn" data-format="16:9">
          <div class="ai-format-preview" style="aspect-ratio:16/9;"></div>
          <span>16:9</span>
          <small>Banner</small>
        </button>
        <button type="button" class="ai-format-btn active" data-format="9:16">
          <div class="ai-format-preview" style="aspect-ratio:9/16;"></div>
          <span>9:16</span>
          <small>Historia</small>
        </button>
        <button type="button" class="ai-format-btn" data-format="1:1">
          <div class="ai-format-preview" style="aspect-ratio:1/1;"></div>
          <span>1:1</span>
          <small>Cuadrado</small>
        </button>
        <button type="button" class="ai-format-btn" data-format="4:5">
          <div class="ai-format-preview" style="aspect-ratio:4/5;"></div>
          <span>4:5</span>
          <small>Vertical</small>
        </button>
      </div>
    </div>

    <!-- Prompt -->
    <div class="ai-section">
      <label class="ai-label" for="story-prompt">Descripción del fondo / escena</label>
      <textarea id="story-prompt" class="form-control" rows="3"
                placeholder="ej: fondo degradado rosado con brillos dorados, estilo elegante y femenino..."></textarea>
      <span class="form-hint">Describí cómo querés que sea el fondo y la ambientación</span>
    </div>

    <!-- Custom Text -->
    <div class="ai-section">
      <label class="ai-label" for="story-custom-text">Texto personalizado (opcional)</label>
      <input type="text" id="story-custom-text" class="form-control"
             placeholder="ej: ¡Ya disponible!, Oferta especial, Nuevo lanzamiento...">
    </div>
  </div>
</div>

<!-- Product Selection -->
<div class="card" style="margin-bottom:1.5rem;">
  <div class="card-header">
    <span class="card-title">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
      Seleccioná productos
    </span>
    <span class="badge badge-purple" id="story-selected-count">0 seleccionados</span>
  </div>
  <div class="card-body">
    <div class="story-products-grid" id="story-products-grid">
      <% if (products.length === 0) { %>
        <div class="cat-empty">
          <p>No hay productos activos con imagen. <a href="/admin/productos/nuevo" style="color:var(--accent);">Crear producto</a></p>
        </div>
      <% } %>
      <% products.forEach(function(p) { %>
      <label class="story-product-card" data-product-id="<%= p.id %>">
        <input type="checkbox" class="story-product-check" value="<%= p.id %>" hidden>
        <div class="story-product-img">
          <img src="/files/<%= p.photo_file_id %>" alt="<%= p.name %>">
          <div class="story-check-overlay">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
        </div>
        <span class="story-product-name"><%= p.name %></span>
        <span class="badge badge-purple" style="font-size:0.65rem;"><%= p.category %></span>
      </label>
      <% }) %>
    </div>
  </div>
</div>

<!-- Generate Button -->
<div style="display:flex;gap:1rem;justify-content:center;margin-bottom:1.5rem;">
  <button type="button" id="story-generate-btn" class="btn btn-ai btn-lg" disabled>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
    Generar Historia con IA
  </button>
</div>

<!-- Loading -->
<div id="story-loading" class="ai-loading hidden">
  <div class="ai-spinner"></div>
  <p>Generando imagen con IA...</p>
  <span>Esto puede tardar hasta 30 segundos</span>
</div>

<!-- Error -->
<div id="story-error" class="ai-error hidden"></div>

<!-- Results -->
<div id="story-results" class="hidden">
  <div class="card">
    <div class="card-header">
      <span class="card-title">✨ Imagen generada</span>
    </div>
    <div class="card-body" style="text-align:center;">
      <div class="story-result-carousel" id="story-result-carousel"></div>
      <div class="ai-actions-bottom" style="margin-top:1rem;">
        <button type="button" id="story-generate-another" class="btn btn-secondary">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
          Generar otra
        </button>
        <button type="button" id="story-download-btn" class="btn btn-primary">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Descargar imagen
        </button>
      </div>
    </div>
  </div>
</div>

<%- include('./partials/layout-end') %>
